-// ParseConfig validates configuration text; file names it in errors.
+// blank reports whether text has nothing but comments and blank lines.
+func blank(text string) bool {
+   for _, raw := range strings.Split(text, "\n") {
+       if strings.TrimSpace(stripComment(trimRightSpace(raw))) != "" {
+           return false
+       }
+   }
+   return true
+}
+
+// problemsError is environment/project_config_invalid for file with one line per problem, sorted
+// by line and message; nil without problems.
+func problemsError(file string, problems []problem) error {
+   if len(problems) == 0 {
+       return nil
+   }
+   sort.SliceStable(problems, func(i, j int) bool {
+       if problems[i].line != problems[j].line {
+           return problems[i].line < problems[j].line
+       }
+       return problems[i].msg < problems[j].msg
+   })
+   e := sys.Fail("environment", "project_config_invalid", file, 3)
+   for _, p := range problems {
+       e.Lines = append(e.Lines, fmt.Sprintf("line %d: %s", p.line, p.msg))
+   }
+   return e
+}
