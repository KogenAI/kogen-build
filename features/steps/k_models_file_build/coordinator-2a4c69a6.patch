+// ParseModels validates the text of one lineup file (`.kogen/models.yaml` or
+// `.kogen/local/models.yaml`) and returns the roles it names, without defaults; file names it
+// in errors. A file with only comments and blank lines names no role.
+func ParseModels(text, file string) (map[string]Role, error) {
+   if blank(text) {
+       return map[string]Role{}, nil
+   }
+   var roles map[string]Role
+   node, problems := parseYAML(text)
+   if problems == nil {
+       v := &validator{}
+       roles = v.models(node)
+       problems = v.problems
+   }
+   if err := problemsError(file, problems); err != nil {
+       return nil, err
+   }
+   return roles, nil
